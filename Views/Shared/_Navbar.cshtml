@* 
  _Navbar.cshtml: Partial View Thanh Menu Điều Hướng Header Toàn Cục (Global Reusable Header Component)
  Nhiệm vụ & Tính năng Tái Sử Dụng:
  1. Tái sử dụng trên tất cả các trang web của khách hàng thông qua Master Layout (_Layout.cshtml).
  2. Hiển thị Logo thương hiệu, Menu xổ xuống (Dropdown) phân loại Phim đang chiếu, Phim sắp chiếu và Thể loại phim.
  3. Đường dẫn nhanh: "Đặt Vé Nhanh" (Fast Booking), "Hệ thống rạp", "Khuyến mãi", "Tin tức".
  4. Thanh Tìm Kiếm Trực Tiếp (Live Search Bar) cho phép gõ từ khóa tìm tên phim.
  5. Menu Tài Khoản & Quyền Đăng Nhập: Tự động đổi giao diện giữa Khách vãng lai (Nút Đăng nhập/Đăng ký) và Người dùng đã đăng nhập (Hiển thị Avatar, Tên, Cấp độ thành viên, Nút Đăng xuất, và Menu Quản trị Admin nếu là Admin).
*@
<!-- Top Bar (Tông 1 - Kem nhạt) -->
<div class="top-bar-earth text-dark d-none d-md-block" style="background-color: var(--color-earth-1); font-size: 13px; padding: 6px 0;">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <i class="bi bi-telephone-fill me-1"></i> Hotline: 1900 1234
            <span class="mx-2">|</span>
            <i class="bi bi-envelope-fill me-1"></i> support@cinemax.vn
        </div>
        <div>
            <a href="#" class="text-dark text-decoration-none me-3"><i class="bi bi-question-circle me-1"></i> Hỗ trợ</a>
            <a href="#" class="text-dark text-decoration-none"><i class="bi bi-translate me-1"></i> VN | EN</a>
        </div>
    </div>
</div>

<nav id="mainNavbar" class="navbar navbar-expand-lg sticky-top smart-navbar" style="z-index: 1050; border-bottom: 1px solid var(--color-primary);">
    <div class="container">
        @* Logo Thương hiệu CinemaX *@
        <a class="navbar-brand fw-bold fs-3 text-danger" href="/">
            <i class="bi bi-film"></i> CinemaX
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            </ul>

            <!-- Sub-navigation (Tông 2 - Cát Khaki) dời xuống dưới, ở đây chỉ để lại Search và Auth -->

            <div class="d-flex me-3 d-none d-lg-flex position-relative search-container flex-grow-1" style="max-width: 500px;">
                <form class="search-form-premium w-100" action="/search" method="GET">
                    <div class="input-group flex-nowrap w-100">
                        <input type="text" name="q" id="mainSearchInput" class="form-control border-end-0 py-2" placeholder="Tìm phim, rạp..." style="border-radius: 20px 0 0 20px;" autocomplete="off">
                        <button type="submit" class="btn bg-white border border-start-0 text-muted px-3" aria-label="Tìm kiếm" style="border-radius: 0 20px 20px 0;"><i class="bi bi-search"></i></button>
                    </div>
                </form>
                <!-- Trending Searches Dropdown -->
                <div id="trendingSearchDropdown" class="dropdown-menu shadow-lg border-0 w-100 mt-2 rounded-4 p-0" style="display: none; position: absolute; top: 100%; left: 0; z-index: 1060; overflow: hidden; animation: dropdownFade 0.3s ease forwards; opacity: 0; transform: translateY(-10px);">
                    <style>
                        @@keyframes dropdownFade {
                            to {
                                opacity: 1;
                                transform: translateY(0);
                            }
                        }
                    </style>
                    <div class="bg-light px-3 py-2 border-bottom border-light">
                        <span class="text-secondary small fw-medium"><i class="bi bi-graph-up-arrow me-1 text-danger"></i> TÌM KIẾM THỊNH HÀNH</span>
                    </div>
                    <ul class="list-unstyled mb-0">
                        <li><a href="/search?q=Lật Mặt 7" class="dropdown-item py-2 d-flex justify-content-between align-items-center transition-all hover-bg-light">Lật Mặt 7 <span class="badge bg-danger rounded-pill">HOT</span></a></li>
                        <li><a href="/search?q=Mai" class="dropdown-item py-2 d-flex justify-content-between align-items-center transition-all hover-bg-light">Phim Mai <span class="badge bg-secondary rounded-pill">1</span></a></li>
                        <li><a href="/search?q=Dune" class="dropdown-item py-2 d-flex justify-content-between align-items-center transition-all hover-bg-light">Dune: Part Two <span class="badge bg-secondary rounded-pill">2</span></a></li>
                        <li><a href="/search?q=Đào, Phở và Piano" class="dropdown-item py-2 d-flex justify-content-between align-items-center transition-all hover-bg-light">Đào, Phở và Piano <span class="badge bg-secondary rounded-pill">3</span></a></li>
                    </ul>
                </div>
            </div>

            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                <!-- Theme Toggle -->
                <li class="nav-item me-2">
                    <button id="themeToggleBtn" class="btn btn-sm btn-outline-secondary" title="Đổi giao diện" aria-label="Đổi giao diện">
                        <i class="bi bi-moon-stars"></i>
                    </button>
                </li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- Notifications -->
                    <li class="nav-item dropdown me-2 d-flex align-items-center">
                        <a class="nav-link position-relative" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Thông báo" aria-label="Thông báo">
                            <i class="bi bi-bell fs-5"></i>
                            <span class="position-absolute top-25 start-75 translate-middle p-1 bg-danger border border-light rounded-circle" style="margin-top: 5px;">
                                <span class="visually-hidden">New alerts</span>
                            </span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow" style="width: 320px;">
                            <li><h6 class="dropdown-header fw-medium">Thông báo mới</h6></li>
                            <li>
                                <a class="dropdown-item py-2 text-wrap" href="#">
                                    <div class="d-flex align-items-start">
                                        <div class="bg-warning text-white rounded-circle p-2 me-3 mt-1"><i class="bi bi-ticket-perforated"></i></div>
                                        <div>
                                            <p class="mb-0 fw-medium small">Nhắc lịch xem phim</p>
                                            <p class="mb-0 small text-secondary" style="font-size: 0.8rem;">Dune: Part Two sẽ chiếu trong 2 giờ nữa tại Landmark 81.</p>
                                        </div>
                                    </div>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2 text-wrap" href="#">
                                    <div class="d-flex align-items-start">
                                        <div class="bg-info text-white rounded-circle p-2 me-3 mt-1"><i class="bi bi-star"></i></div>
                                        <div>
                                            <p class="mb-0 fw-medium small">Điểm thưởng cập nhật</p>
                                            <p class="mb-0 small text-secondary" style="font-size: 0.8rem;">Bạn vừa được cộng 5,000 điểm từ giao dịch gần nhất.</p>
                                        </div>
                                    </div>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-center small text-primary fw-medium" href="#">Xem tất cả thông báo</a></li>
                        </ul>
                    </li>

                    @if (User.IsInRole("admin"))
                    {
                        <li class="nav-item d-flex align-items-center">
                            <a class="nav-link text-primary fw-semibold me-2" href="/admin/dashboard">
                                <i class="bi bi-speedometer2"></i> Admin Panel
                            </a>
                        </li>
                    }

                    <!-- User Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="https://api.dicebear.com/7.x/initials/svg?seed=@User.Identity.Name"
                                 class="rounded-circle" width="28" height="28" style="object-fit: cover;"
                                 alt="avatar">
                            <span class="d-none d-lg-inline">@User.Identity.Name</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="/profile">
                                    <i class="bi bi-person me-2"></i>Hồ sơ
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/my-tickets">
                                    Vé của tôi
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/profile/transactions">
                                    <i class="bi bi-receipt me-2"></i>Lịch sử giao dịch
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="POST" action="/logout">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link me-3 fw-medium text-dark" href="/login">Đăng nhập</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-danger fw-bold rounded-pill px-4 shadow-sm" href="/register">Đăng ký</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<!-- Sub Navigation (Tông 2 - Cát Khaki) -->
<div class="sub-nav-earth d-none d-lg-block shadow-sm" style="background-color: var(--color-earth-2); border-bottom: 2px solid var(--color-primary);">
    <div class="container d-flex justify-content-between align-items-center">
        <!-- Left Menu -->
        <ul class="nav py-2 fw-medium align-items-center flex-grow-1" style="font-size: 15px; gap: 1.5rem;">
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle text-dark px-0 hover-primary" href="#" id="navbarDropdownMovies" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-film me-1"></i> Phim
                </a>
                <ul class="dropdown-menu shadow border-0 mt-2" aria-labelledby="navbarDropdownMovies">
                    <li><h6 class="dropdown-header text-danger fw-bold">Danh mục</h6></li>
                    <li><a class="dropdown-item py-2" href="/movies">Phim Đang Chiếu</a></li>
                    <li><a class="dropdown-item py-2" href="/movies?status=coming_soon">Phim Sắp Chiếu</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header text-danger fw-bold">Thể loại</h6></li>
                    <li><a class="dropdown-item py-2" href="/movies?genre=Hành động">Hành Động</a></li>
                    <li><a class="dropdown-item py-2" href="/movies?genre=Khoa học viễn tưởng">Viễn Tưởng</a></li>
                    <li><a class="dropdown-item py-2" href="/movies?genre=Kinh dị">Kinh Dị</a></li>
                </ul>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark px-0 hover-primary" href="/cinemas/showtimes">Lịch chiếu</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark px-0 hover-primary" href="/cinemas">Hệ thống rạp</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark px-0 hover-primary" href="/promotions">Ưu đãi</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark px-0 hover-primary" href="/news">Tin tức</a>
            </li>
            <li class="nav-item ms-3">
                <a class="btn btn-danger btn-sm rounded-pill px-4 fw-bold shadow-sm d-flex align-items-center" href="/booking/fast">
                    <i class="bi bi-lightning-charge-fill me-1"></i> ĐẶT VÉ NHANH
                </a>
            </li>
        </ul>
        
        <!-- Right Widget: Cinema Selector / Status -->
        <div class="d-flex align-items-center text-dark text-opacity-75 dropdown" style="font-size: 14px;">
            <i class="bi bi-geo-alt-fill text-danger me-1"></i>
            <span class="me-2">Rạp đang chọn:</span>
            <a href="#" class="text-dark fw-bold text-decoration-none border-bottom border-dark border-opacity-25 pb-1 hover-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                Toàn Quốc
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                <li><h6 class="dropdown-header text-danger fw-bold">Chọn khu vực</h6></li>
                <li><a class="dropdown-item py-2 fw-medium bg-light" href="#"><i class="bi bi-check2 text-success me-2"></i>Toàn Quốc</a></li>
                <li><a class="dropdown-item py-2" href="/cinemas?location=hcm">TP. Hồ Chí Minh</a></li>
                <li><a class="dropdown-item py-2" href="/cinemas?location=hn">Hà Nội</a></li>
                <li><a class="dropdown-item py-2" href="/cinemas?location=dn">Đà Nẵng</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item py-2 text-primary fw-medium" href="/cinemas"><i class="bi bi-search me-2"></i>Xem tất cả rạp</a></li>
            </ul>
        </div>
    </div>
</div>
<style>
.hover-primary:hover {
    color: var(--color-primary) !important;
}
</style>
