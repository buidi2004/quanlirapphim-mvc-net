@model CinemaXNet.Application.ViewModels.PaginatedList<CinemaXNet.Domain.Entities.Movie>
@{
    ViewData["Title"] = "Danh Sách Phim";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var genre  = ViewBag.Genre as string;
    var status = (string)(ViewBag.Status ?? "now_showing");
}

<style>
    .movie-filter-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 18px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        text-decoration: none;
        border: 2px solid #e5e7eb;
        background: #fff;
        color: var(--color-text-secondary, #6B7280);
        transition: all 0.2s ease;
    }
    .movie-filter-pill:hover {
        border-color: var(--color-primary, #F84464);
        color: var(--color-primary, #F84464);
        background: #fff5f7;
    }
    .movie-filter-pill.active {
        background: var(--color-primary, #F84464);
        border-color: var(--color-primary, #F84464);
        color: #fff;
        box-shadow: 0 4px 12px rgba(248, 68, 100, 0.3);
    }
    .genre-btn {
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 7px 16px;
        border: 2px solid var(--color-primary, #F84464);
        color: var(--color-primary, #F84464);
        background: transparent;
        transition: all 0.2s ease;
    }
    .genre-btn:hover, .genre-btn:focus, .show > .genre-btn {
        background: var(--color-primary, #F84464);
        color: #fff;
        border-color: var(--color-primary, #F84464);
    }
    .genre-menu {
        border-radius: 12px;
        overflow: hidden;
        border: none;
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    }
    .genre-menu .dropdown-item.active,
    .genre-menu .dropdown-item:active {
        background: var(--color-primary, #F84464);
    }
    .movie-card-item {
        cursor: pointer;
        border-radius: 12px !important;
        overflow: hidden;
        border: none !important;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .movie-card-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 24px rgba(0,0,0,0.14);
    }
    .movie-card-item .poster-wrap img {
        transition: transform 0.35s ease;
    }
    .movie-card-item:hover .poster-wrap img {
        transform: scale(1.05);
    }
    .badge-xem {
        background: linear-gradient(135deg, #F84464, #ff6b6b);
        color: #fff;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        padding: 3px 10px;
        border-radius: 999px;
    }
</style>

<div class="mb-4">
    <h1 class="h3 fw-bold text-dark mb-4">Danh Sách Phim</h1>

    <!-- Filter bar -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <!-- Status pills -->
        <div class="d-flex gap-2 flex-wrap">
            <a href="/movies?status=now_showing@(genre != null ? "&genre=" + Uri.EscapeDataString(genre) : "")"
               class="movie-filter-pill @(status == "now_showing" ? "active" : "")">
                <i class="bi bi-play-fill"></i> Đang chiếu
            </a>
            <a href="/movies?status=coming_soon@(genre != null ? "&genre=" + Uri.EscapeDataString(genre) : "")"
               class="movie-filter-pill @(status == "coming_soon" ? "active" : "")">
                <i class="bi bi-calendar-event"></i> Sắp chiếu
            </a>
            <a href="/movies?status=ended@(genre != null ? "&genre=" + Uri.EscapeDataString(genre) : "")"
               class="movie-filter-pill @(status == "ended" ? "active" : "")">
                <i class="bi bi-archive"></i> Đã chiếu
            </a>
        </div>

        <!-- Genre dropdown -->
        <div class="dropdown">
            <button class="genre-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-funnel me-1"></i>@(genre ?? "Tất cả thể loại")
            </button>
            <ul class="dropdown-menu dropdown-menu-end genre-menu">
                <li><a class="dropdown-item @(genre == null ? "active" : "")" href="/movies?status=@status">Tất cả</a></li>
                <li><a class="dropdown-item @(genre == "Hành động" ? "active" : "")" href="/movies?status=@status&genre=@Uri.EscapeDataString("Hành động")">Hành động</a></li>
                <li><a class="dropdown-item @(genre == "Hài" ? "active" : "")" href="/movies?status=@status&genre=@Uri.EscapeDataString("Hài")">Hài</a></li>
                <li><a class="dropdown-item @(genre == "Kinh dị" ? "active" : "")" href="/movies?status=@status&genre=@Uri.EscapeDataString("Kinh dị")">Kinh dị</a></li>
                <li><a class="dropdown-item @(genre == "Tình cảm" ? "active" : "")" href="/movies?status=@status&genre=@Uri.EscapeDataString("Tình cảm")">Tình cảm</a></li>
                <li><a class="dropdown-item @(genre == "Viễn tưởng" ? "active" : "")" href="/movies?status=@status&genre=@Uri.EscapeDataString("Viễn tưởng")">Viễn tưởng</a></li>
                <li><a class="dropdown-item @(genre == "Hoạt hình" ? "active" : "")" href="/movies?status=@status&genre=@Uri.EscapeDataString("Hoạt hình")">Hoạt hình</a></li>
            </ul>
        </div>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-camera-reels text-secondary display-1 mb-3"></i>
        <p class="text-secondary fs-5 fst-italic">Không tìm thấy phim phù hợp với bộ lọc hiện tại.</p>
    </div>
}
else
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-4">
        @foreach (var movie in Model.Items)
        {
            <div class="col">
                <div class="card movie-card-item h-100 bg-white"
                     onclick="location.href='/movies/@movie.Id'">
                    <div class="poster-wrap position-relative overflow-hidden" style="height: 290px;">
                        <img src="@(movie.PosterUrl ?? "https://placehold.co/400x600/111/fff?text=No+Poster")"
                             class="w-100 h-100"
                             alt="@movie.Title"
                             style="object-fit: cover;" loading="lazy" decoding="async">
                        @if (movie.AgeRating != null)
                        {
                            <span class="badge position-absolute top-0 end-0 m-2 badge-@movie.AgeRating.ToLower()">
                                @movie.AgeRating
                            </span>
                        }
                    </div>
                    <div class="card-body p-3">
                        <h6 class="card-title text-dark mb-2 text-truncate fw-semibold" title="@movie.Title">@movie.Title</h6>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-secondary">
                                <i class="bi bi-clock me-1"></i>@movie.GetFormattedDuration()
                            </small>
                            <span class="badge-xem">Xem</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @await Html.PartialAsync("_Pagination", Model)
}
