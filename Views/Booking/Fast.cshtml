@{
    ViewData["Title"] = ViewBag.PageTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var movies = ViewBag.Movies as IEnumerable<CinemaXNet.Domain.Entities.Movie> ?? [];
    var cinemas = ViewBag.Cinemas as IEnumerable<CinemaXNet.Domain.Entities.Cinema> ?? [];
}

<style>
    .fast-booking-wrapper {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    }
    .fb-header {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 20px 24px;
        background: rgba(255,255,255,0.04);
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .fb-title {
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        color: var(--color-primary, #F84464);
        margin: 0;
        text-transform: uppercase;
    }
    .fb-title i { color: var(--color-primary, #F84464); }

    /* Step columns */
    .fb-cols { display: flex; height: 480px; }
    .fb-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        border-right: 1px solid rgba(255,255,255,0.07);
    }
    .fb-col:last-child { border-right: none; }

    /* Step header */
    .fb-step-head {
        padding: 14px 16px;
        background: rgba(255,255,255,0.05);
        border-bottom: 1px solid rgba(255,255,255,0.07);
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .fb-step-num {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: rgba(248,68,100,0.2);
        border: 1.5px solid var(--color-primary, #F84464);
        color: var(--color-primary, #F84464);
        font-size: 0.72rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .fb-step-label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.75);
    }
    .fb-step-head.done .fb-step-num {
        background: var(--color-primary, #F84464);
        color: #fff;
    }

    /* Scroll body */
    .fb-body {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
    }
    .fb-body::-webkit-scrollbar { width: 4px; }
    .fb-body::-webkit-scrollbar-track { background: transparent; }
    .fb-body::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 4px; }

    /* Movie item */
    .fb-movie-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        cursor: pointer;
        border: none;
        background: transparent;
        width: 100%;
        text-align: left;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        transition: background 0.15s;
        color: rgba(255,255,255,0.85);
    }
    .fb-movie-item:hover { background: rgba(255,255,255,0.06); }
    .fb-movie-item.active {
        background: rgba(248,68,100,0.15);
        border-left: 3px solid var(--color-primary, #F84464);
    }
    .fb-movie-poster {
        width: 38px;
        height: 56px;
        object-fit: cover;
        border-radius: 6px;
        flex-shrink: 0;
    }
    .fb-movie-title { font-size: 0.82rem; font-weight: 600; line-height: 1.3; margin-bottom: 3px; }
    .fb-movie-meta { font-size: 0.72rem; color: rgba(255,255,255,0.45); display: flex; align-items: center; gap: 6px; }

    /* Cinema item */
    .fb-cinema-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 16px;
        cursor: pointer;
        border: none;
        background: transparent;
        width: 100%;
        text-align: left;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        transition: background 0.15s;
        color: rgba(255,255,255,0.8);
        font-size: 0.83rem;
    }
    .fb-cinema-item:hover { background: rgba(255,255,255,0.06); }
    .fb-cinema-item.active {
        background: rgba(248,68,100,0.15);
        border-left: 3px solid var(--color-primary, #F84464);
        color: #fff;
        font-weight: 600;
    }
    .fb-cinema-icon {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: rgba(248,68,100,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: var(--color-primary, #F84464);
        font-size: 0.8rem;
    }

    /* Date item */
    .fb-date-item {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        padding: 13px 16px;
        cursor: pointer;
        border: none;
        background: transparent;
        width: 100%;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        transition: background 0.15s;
        color: rgba(255,255,255,0.7);
        font-size: 0.83rem;
        font-weight: 500;
        gap: 2px;
    }
    .fb-date-item:hover { background: rgba(255,255,255,0.06); }
    .fb-date-item.active {
        background: rgba(248,68,100,0.15);
        border-left: 3px solid var(--color-primary, #F84464);
        color: var(--color-primary, #F84464);
        font-weight: 700;
    }

    /* Showtime buttons */
    .fb-time-grid { padding: 14px; display: flex; flex-wrap: wrap; gap: 8px; align-content: flex-start; }
    .fb-time-btn {
        flex: 0 0 calc(50% - 4px);
        padding: 10px 8px;
        border-radius: 10px;
        border: 1.5px solid rgba(248,68,100,0.4);
        background: rgba(248,68,100,0.08);
        color: var(--color-primary, #F84464);
        font-size: 0.82rem;
        font-weight: 700;
        text-align: center;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .fb-time-btn:hover {
        background: var(--color-primary, #F84464);
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(248,68,100,0.35);
    }

    /* Empty state */
    .fb-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        gap: 10px;
        color: rgba(255,255,255,0.3);
        font-size: 0.8rem;
        font-style: italic;
        padding: 20px;
        text-align: center;
    }
    .fb-empty i { font-size: 2rem; opacity: 0.4; }

    /* Spinner */
    .fb-spinner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 100%;
        color: var(--color-primary, #F84464);
        font-size: 0.82rem;
    }

    @media (max-width: 767px) {
        .fb-cols { flex-direction: column; height: auto; }
        .fb-col { height: 220px; border-right: none; border-bottom: 1px solid rgba(255,255,255,0.07); }
        .fb-col:last-child { border-bottom: none; }
    }
</style>

<div class="py-4">
    <div class="fast-booking-wrapper">
        <!-- Header -->
        <div class="fb-header">
            <i class="bi bi-lightning-charge-fill" style="color: var(--color-primary); font-size: 1.1rem;"></i>
            <h2 class="fb-title">Đặt Vé Nhanh</h2>
        </div>

        <!-- 4 columns -->
        <div class="fb-cols">

            <!-- Col 1: Phim -->
            <div class="fb-col">
                <div class="fb-step-head" id="head-1">
                    <div class="fb-step-num">1</div>
                    <span class="fb-step-label">Chọn Phim</span>
                </div>
                <div class="fb-body">
                    @foreach (var m in movies)
                    {
                        <button class="fb-movie-item" data-id="@m.Id">
                            <img src="@(m.PosterUrl ?? "/images/no-poster.jpg")" class="fb-movie-poster" alt="@m.Title">
                            <div>
                                <div class="fb-movie-title">@m.Title</div>
                                <div class="fb-movie-meta">
                                    @if (m.AgeRating != null) {
                                        <span class="badge" style="background: var(--color-primary); font-size: 0.65rem; padding: 2px 6px;">@m.AgeRating</span>
                                    }
                                    <span>@m.DurationMinutes phút</span>
                                </div>
                            </div>
                        </button>
                    }
                </div>
            </div>

            <!-- Col 2: Rạp -->
            <div class="fb-col">
                <div class="fb-step-head" id="head-2">
                    <div class="fb-step-num">2</div>
                    <span class="fb-step-label">Chọn Rạp</span>
                </div>
                <div class="fb-body" id="cinema-list">
                    <div class="fb-empty">
                        <i class="bi bi-arrow-left-circle"></i>
                        Vui lòng chọn phim trước
                    </div>
                </div>
            </div>

            <!-- Col 3: Ngày -->
            <div class="fb-col">
                <div class="fb-step-head" id="head-3">
                    <div class="fb-step-num">3</div>
                    <span class="fb-step-label">Chọn Ngày</span>
                </div>
                <div class="fb-body" id="date-list">
                    <div class="fb-empty">
                        <i class="bi bi-arrow-left-circle"></i>
                        Vui lòng chọn rạp trước
                    </div>
                </div>
            </div>

            <!-- Col 4: Suất -->
            <div class="fb-col">
                <div class="fb-step-head" id="head-4">
                    <div class="fb-step-num">4</div>
                    <span class="fb-step-label">Chọn Suất</span>
                </div>
                <div class="fb-body" id="time-list">
                    <div class="fb-empty">
                        <i class="bi bi-arrow-left-circle"></i>
                        Vui lòng chọn ngày trước
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedMovie = null;
        let selectedCinema = null;
        let selectedDate = null;

        function markStepDone(headId) {
            document.getElementById(headId)?.classList.add('done');
        }

        function showEmpty(id, msg) {
            document.getElementById(id).innerHTML =
                `<div class="fb-empty"><i class="bi bi-arrow-left-circle"></i>${msg}</div>`;
        }

        function showSpinner(id) {
            document.getElementById(id).innerHTML =
                `<div class="fb-spinner"><div class="spinner-border spinner-border-sm"></div> Đang tải...</div>`;
        }

        // Movie select
        document.querySelectorAll('.fb-movie-item').forEach(item => {
            item.addEventListener('click', function () {
                document.querySelectorAll('.fb-movie-item').forEach(i => i.classList.remove('active'));
                this.classList.add('active');
                selectedMovie = this.getAttribute('data-id');
                selectedCinema = null;
                selectedDate = null;
                markStepDone('head-1');
                showEmpty('date-list', 'Vui lòng chọn rạp trước');
                showEmpty('time-list', 'Vui lòng chọn ngày trước');
                loadCinemas(selectedMovie);
            });
        });

        async function loadCinemas(movieId) {
            showSpinner('cinema-list');
            try {
                const res = await fetch(`/api/quickbooking/cinemas?movieId=${movieId}`);
                const data = await res.json();
                const list = document.getElementById('cinema-list');
                if (data.length === 0) { showEmpty('cinema-list', 'Không có rạp nào chiếu phim này'); return; }
                list.innerHTML = '';
                data.forEach(c => {
                    const btn = document.createElement('button');
                    btn.className = 'fb-cinema-item';
                    btn.innerHTML = `<div class="fb-cinema-icon"><i class="bi bi-building"></i></div><span>${c.name}</span>`;
                    btn.onclick = () => {
                        document.querySelectorAll('.fb-cinema-item').forEach(i => i.classList.remove('active'));
                        btn.classList.add('active');
                        selectedCinema = c.id;
                        selectedDate = null;
                        markStepDone('head-2');
                        showEmpty('time-list', 'Vui lòng chọn ngày trước');
                        loadDates(movieId, c.id);
                    };
                    list.appendChild(btn);
                });
            } catch { showEmpty('cinema-list', 'Lỗi kết nối'); }
        }

        async function loadDates(movieId, cinemaId) {
            showSpinner('date-list');
            try {
                const res = await fetch(`/api/quickbooking/dates?movieId=${movieId}&cinemaId=${cinemaId}`);
                const data = await res.json();
                const list = document.getElementById('date-list');
                list.innerHTML = '';
                if (data.length === 0) { showEmpty('date-list', 'Không có ngày chiếu nào'); return; }
                data.forEach(d => {
                    const btn = document.createElement('button');
                    btn.className = 'fb-date-item';
                    btn.textContent = d.formatted;
                    btn.onclick = () => {
                        document.querySelectorAll('.fb-date-item').forEach(i => i.classList.remove('active'));
                        btn.classList.add('active');
                        selectedDate = d.value;
                        markStepDone('head-3');
                        loadShowtimes(movieId, cinemaId, d.value);
                    };
                    list.appendChild(btn);
                });
            } catch { showEmpty('date-list', 'Lỗi kết nối'); }
        }

        async function loadShowtimes(movieId, cinemaId, date) {
            showSpinner('time-list');
            try {
                const res = await fetch(`/api/quickbooking/showtimes?movieId=${movieId}&cinemaId=${cinemaId}&date=${date}`);
                const data = await res.json();
                const list = document.getElementById('time-list');
                if (data.length === 0) { showEmpty('time-list', 'Không có suất chiếu nào'); return; }
                list.innerHTML = '<div class="fb-time-grid"></div>';
                const grid = list.querySelector('.fb-time-grid');
                data.forEach(st => {
                    const a = document.createElement('a');
                    a.href = `/booking/seats?showtimeId=${st.id}`;
                    a.className = 'fb-time-btn';
                    a.textContent = st.time;
                    grid.appendChild(a);
                });
            } catch { showEmpty('time-list', 'Lỗi kết nối'); }
        }
    </script>
}
