@{
    ViewData["Title"] = "Quản Lý Thanh Toán & Đối Soát";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom border-secondary-subtle">
    <h1 class="h3 text-body-emphasis fw-bold mb-0">Quản Lý Thanh Toán</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <button type="button" class="btn btn-sm btn-outline-success d-flex align-items-center gap-2">
            <i class="bi bi-file-earmark-excel"></i> Xuất Báo Cáo Đối Soát
        </button>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Cổng thanh toán (Donut Chart) -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-body">
            <div class="card-header bg-transparent border-0 pt-4 pb-0 px-4">
                <h5 class="fw-bold mb-0 text-body-emphasis">Tỷ Trọng Cổng Thanh Toán</h5>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center">
                <div id="paymentGatewaysChart"></div>
            </div>
        </div>
    </div>

    <!-- Tổng quan thanh toán -->
    <div class="col-lg-8">
        <div class="row g-4 h-100">
            <div class="col-sm-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-body p-4 d-flex justify-content-center">
                    <div class="d-flex align-items-center gap-4">
                        <div class="p-4 bg-success bg-opacity-10 text-success rounded-circle">
                            <i class="bi bi-check-circle-fill fs-1"></i>
                        </div>
                        <div>
                            <p class="text-secondary fw-medium mb-1">Giao dịch thành công (Hôm nay)</p>
                            <h2 class="text-body-emphasis fw-bold mb-0">1,245</h2>
                            <small class="text-success fw-bold"><i class="bi bi-arrow-up-short"></i> 12.5% so với hôm qua</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-body p-4 d-flex justify-content-center">
                    <div class="d-flex align-items-center gap-4">
                        <div class="p-4 bg-danger bg-opacity-10 text-danger rounded-circle">
                            <i class="bi bi-x-circle-fill fs-1"></i>
                        </div>
                        <div>
                            <p class="text-secondary fw-medium mb-1">Giao dịch thất bại / Refund</p>
                            <h2 class="text-body-emphasis fw-bold mb-0">32</h2>
                            <small class="text-danger fw-bold"><i class="bi bi-arrow-up-short"></i> 2.1% so với hôm qua</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lịch sử giao dịch -->
<div class="card border-0 shadow-sm rounded-4 bg-body mb-4">
    <div class="card-header bg-transparent border-0 pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-body-emphasis">Nhật Ký Giao Dịch Mới Nhất</h5>
        <div class="input-group" style="max-width: 300px;">
            <input type="text" class="form-control form-control-sm" placeholder="Tìm mã GD, Email...">
            <button class="btn btn-sm btn-outline-secondary" type="button"><i class="bi bi-search"></i></button>
        </div>
    </div>
    <div class="card-body px-4 pb-4 pt-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="text-secondary small">
                    <tr>
                        <th class="border-0 pb-3">Mã GD</th>
                        <th class="border-0 pb-3">Khách hàng</th>
                        <th class="border-0 pb-3">Phương thức</th>
                        <th class="border-0 pb-3 text-end">Tổng tiền</th>
                        <th class="border-0 pb-3 text-center">Trạng thái</th>
                        <th class="border-0 pb-3 text-end">Thời gian</th>
                        <th class="border-0 pb-3 text-center">Hóa đơn VAT</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    <tr>
                        <td class="fw-bold text-body-emphasis">#TXN-99823</td>
                        <td>
                            <div class="d-flex flex-column">
                                <span class="text-body-emphasis fw-medium small">Nguyễn Văn A</span>
                                <span class="text-secondary" style="font-size: 0.75rem;">nva@gmail.com</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle rounded-pill px-3 py-2">
                                <i class="bi bi-credit-card-2-front me-1"></i> VNPay
                            </span>
                        </td>
                        <td class="text-end fw-bold text-body-emphasis">250,000₫</td>
                        <td class="text-center"><span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Thành công</span></td>
                        <td class="text-end text-secondary small">14:32 25/07/2026</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-primary" title="Xuất hóa đơn VAT"><i class="bi bi-receipt"></i> Export</button>
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-body-emphasis">#TXN-99822</td>
                        <td>
                            <div class="d-flex flex-column">
                                <span class="text-body-emphasis fw-medium small">Lê Thị B</span>
                                <span class="text-secondary" style="font-size: 0.75rem;">ltb@gmail.com</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle rounded-pill px-3 py-2">
                                <i class="bi bi-wallet2 me-1"></i> Momo
                            </span>
                        </td>
                        <td class="text-end fw-bold text-body-emphasis">180,000₫</td>
                        <td class="text-center"><span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Thành công</span></td>
                        <td class="text-end text-secondary small">14:28 25/07/2026</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-primary" title="Xuất hóa đơn VAT"><i class="bi bi-receipt"></i> Export</button>
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-body-emphasis">#TXN-99821</td>
                        <td>
                            <div class="d-flex flex-column">
                                <span class="text-body-emphasis fw-medium small">Trần C</span>
                                <span class="text-secondary" style="font-size: 0.75rem;">tranc@gmail.com</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle rounded-pill px-3 py-2">
                                <i class="bi bi-cash me-1"></i> Tại Quầy
                            </span>
                        </td>
                        <td class="text-end fw-bold text-body-emphasis">350,000₫</td>
                        <td class="text-center"><span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3">Đang xử lý</span></td>
                        <td class="text-end text-secondary small">14:15 25/07/2026</td>
                        <td class="text-center">
                            <span class="text-muted small">N/A</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-body-emphasis">#TXN-99820</td>
                        <td>
                            <div class="d-flex flex-column">
                                <span class="text-body-emphasis fw-medium small">Phạm D</span>
                                <span class="text-secondary" style="font-size: 0.75rem;">phamd@gmail.com</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-info bg-opacity-10 text-info border border-info-subtle rounded-pill px-3 py-2">
                                <i class="bi bi-wallet me-1"></i> ZaloPay
                            </span>
                        </td>
                        <td class="text-end fw-bold text-body-emphasis">120,000₫</td>
                        <td class="text-center"><span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3">Thất bại</span></td>
                        <td class="text-end text-secondary small">14:05 25/07/2026</td>
                        <td class="text-center">
                            <span class="text-muted small">N/A</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
            const textColor = isDark ? '#adb5bd' : '#6c757d';

            var donutOptions = {
                series: [45, 30, 15, 10],
                labels: ['VNPay', 'Momo', 'ZaloPay', 'Tiền Mặt'],
                chart: {
                    type: 'donut',
                    height: 300,
                    fontFamily: 'Inter, sans-serif'
                },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '70%',
                            labels: {
                                show: true,
                                name: { color: textColor },
                                value: { 
                                    color: isDark ? '#fff' : '#000',
                                    formatter: function (val) {
                                        return val + "%"
                                    }
                                }
                            }
                        }
                    }
                },
                colors: ['#0d6efd', '#dc3545', '#0dcaf0', '#6c757d'],
                stroke: { show: false },
                dataLabels: { enabled: false },
                legend: {
                    position: 'bottom',
                    labels: { colors: textColor }
                }
            };

            var donutChart = new ApexCharts(document.querySelector("#paymentGatewaysChart"), donutOptions);
            donutChart.render();

            // Handle Theme Toggle
            const themeToggleBtn = document.getElementById('themeToggleBtn');
            if (themeToggleBtn) {
                themeToggleBtn.addEventListener('click', () => {
                    setTimeout(() => {
                        const newIsDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
                        const newTextColor = newIsDark ? '#adb5bd' : '#6c757d';
                        
                        donutChart.updateOptions({
                            plotOptions: {
                                pie: {
                                    donut: {
                                        labels: {
                                            name: { color: newTextColor },
                                            value: { color: newIsDark ? '#fff' : '#000' }
                                        }
                                    }
                                }
                            },
                            legend: {
                                labels: { colors: newTextColor }
                            }
                        });
                    }, 50);
                });
            }
        });
    </script>
}
