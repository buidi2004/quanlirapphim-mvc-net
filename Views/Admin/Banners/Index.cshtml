@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Quản Lý Banner";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var banners = Model?.ToList() ?? new List<dynamic>();
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom border-secondary-subtle">
    <h1 class="h2 text-warning fw-medium">Quản Lý Banner Quảng Cáo</h1>
    <button type="button" class="btn btn-primary fw-medium btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#addBannerModal">
        <i class="bi bi-plus-lg"></i> Thêm Banner
    </button>
</div>

<div class="alert alert-info border-0 shadow-sm mb-4">
    <i class="bi bi-info-circle me-2"></i>
    Banner sẽ hiển thị dạng carousel trên trang chủ. Sắp xếp theo <strong>Thứ tự</strong> (số nhỏ hiển thị trước). Chỉ các banner <strong>Đang bật</strong> mới hiển thị cho người dùng.
</div>

<div class="card bg-body border border-secondary-subtle rounded shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 120px;">Ảnh</th>
                    <th scope="col">Tiêu đề</th>
                    <th scope="col">Mô tả</th>
                    <th scope="col" style="width: 80px;">Thứ tự</th>
                    <th scope="col" style="width: 100px;">Trạng thái</th>
                    <th scope="col" class="text-end" style="width: 120px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!banners.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-secondary fst-italic">
                            Chưa có banner nào. Bấm "Thêm Banner" để tạo mới.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var b in banners)
                    {
                        <tr>
                            <td>
                                <img src="@(b.image_url ?? "https://placehold.co/160x80/111/fff?text=No+Image")"
                                     alt="Banner" class="img-thumbnail bg-light border-secondary-subtle rounded shadow-sm"
                                     style="width: 120px; height: 60px; object-fit: cover;">
                            </td>
                            <td><strong class="text-body-emphasis">@b.title</strong></td>
                            <td class="text-secondary small">@(b.description ?? "—")</td>
                            <td><span class="badge bg-info text-body-emphasis">@b.sort_order</span></td>
                            <td>
                                @if (Convert.ToBoolean(b.is_active))
                                {
                                    <span class="badge bg-success">Đang bật</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã tắt</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#editBannerModal-@b.id">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteBannerModal-@b.id">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>

                        <!-- Edit Modal -->
                        <div class="modal fade" id="editBannerModal-@b.id" tabindex="-1">
                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                <div class="modal-content bg-light text-body-emphasis border border-secondary-subtle shadow-lg">
                                    <div class="modal-header bg-body border-bottom border-secondary-subtle">
                                        <h5 class="modal-title text-warning fw-medium">Sửa Banner</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form method="post" action="/admin/banners/update" enctype="multipart/form-data">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@b.id" />
                                        <div class="modal-body p-4 text-start">
                                            <div class="mb-3">
                                                <label class="form-label text-body-emphasis fw-medium">Tiêu đề banner</label>
                                                <input type="text" name="title" value="@b.title" class="form-control bg-body text-body-emphasis border-secondary-subtle" required>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label text-body-emphasis fw-medium">Mô tả ngắn</label>
                                                <textarea name="description" rows="2" class="form-control bg-body text-body-emphasis border-secondary-subtle">@b.description</textarea>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label text-body-emphasis fw-medium">Ảnh banner mới (để trống nếu giữ nguyên)</label>
                                                <input type="file" name="image" class="form-control bg-body text-body-emphasis border-secondary-subtle" accept="image/*">
                                                @if (b.image_url != null)
                                                {
                                                    <div class="mt-2">
                                                        <img src="@b.image_url" class="img-thumbnail" style="max-height: 80px;" alt="Current">
                                                    </div>
                                                }
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label text-body-emphasis fw-medium">Link khi click (tuỳ chọn)</label>
                                                    <input type="text" name="linkUrl" value="@b.link_url" class="form-control bg-body text-body-emphasis border-secondary-subtle" placeholder="/promotions hoặc URL">
                                                </div>
                                                <div class="col-md-3 mb-3">
                                                    <label class="form-label text-body-emphasis fw-medium">Thứ tự</label>
                                                    <input type="number" name="sortOrder" value="@b.sort_order" class="form-control bg-body text-body-emphasis border-secondary-subtle" min="0">
                                                </div>
                                                <div class="col-md-3 mb-3">
                                                    <label class="form-label text-body-emphasis fw-medium">Trạng thái</label>
                                                    <select name="isActive" class="form-select bg-body text-body-emphasis border-secondary-subtle">
                                                        @if (Convert.ToBoolean(b.is_active))
                                                        {
                                                            <option value="true" selected>Đang bật</option>
                                                            <option value="false">Đã tắt</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="true">Đang bật</option>
                                                            <option value="false" selected>Đã tắt</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="modal-footer bg-body border-top border-secondary-subtle">
                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                                            <button type="submit" class="btn btn-info fw-medium">Cập nhật</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Delete Modal -->
                        <div class="modal fade" id="deleteBannerModal-@b.id" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content bg-light text-body-emphasis border border-secondary-subtle shadow-lg">
                                    <div class="modal-header bg-body border-bottom border-secondary-subtle">
                                        <h5 class="modal-title text-danger fw-medium">Xác Nhận Xóa</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body p-4 text-start">
                                        Bạn có chắc chắn muốn xóa banner <strong>@b.title</strong>?
                                    </div>
                                    <div class="modal-footer bg-body border-top border-secondary-subtle">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                                        <form method="post" action="/admin/banners/delete">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@b.id" />
                                            <button type="submit" class="btn btn-danger fw-medium">Xóa</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addBannerModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-light text-body-emphasis border border-secondary-subtle shadow-lg">
            <div class="modal-header bg-body border-bottom border-secondary-subtle">
                <h5 class="modal-title text-warning fw-medium">Thêm Banner Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/admin/banners" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4 text-start">
                    <div class="mb-3">
                        <label class="form-label text-body-emphasis fw-medium">Tiêu đề banner</label>
                        <input type="text" name="title" class="form-control bg-body text-body-emphasis border-secondary-subtle" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-body-emphasis fw-medium">Mô tả ngắn (tuỳ chọn)</label>
                        <textarea name="description" rows="2" class="form-control bg-body text-body-emphasis border-secondary-subtle"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-body-emphasis fw-medium">Ảnh banner <span class="text-danger">*</span></label>
                        <input type="file" name="image" class="form-control bg-body text-body-emphasis border-secondary-subtle" accept="image/*" required>
                        <div class="form-text">Kích thước đề xuất: 1200×500 px. Chấp nhận: JPG, PNG, GIF, WEBP</div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-body-emphasis fw-medium">Link khi click (tuỳ chọn)</label>
                            <input type="text" name="linkUrl" class="form-control bg-body text-body-emphasis border-secondary-subtle" placeholder="/promotions hoặc URL">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label text-body-emphasis fw-medium">Thứ tự</label>
                            <input type="number" name="sortOrder" value="0" class="form-control bg-body text-body-emphasis border-secondary-subtle" min="0">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label text-body-emphasis fw-medium">Trạng thái</label>
                            <select name="isActive" class="form-select bg-body text-body-emphasis border-secondary-subtle">
                                <option value="true" selected>Đang bật</option>
                                <option value="false">Đã tắt</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-body border-top border-secondary-subtle">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-medium">Thêm Banner</button>
                </div>
            </form>
        </div>
    </div>
</div>
