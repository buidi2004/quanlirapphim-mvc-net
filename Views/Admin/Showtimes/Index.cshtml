@model IEnumerable<CinemaXNet.Domain.Entities.Showtime>
@{
    ViewData["Title"] = "Quản Lý Suất Chiếu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var showtimes = Model?.ToList() ?? new List<CinemaXNet.Domain.Entities.Showtime>();
    var movies = ViewBag.Movies as IEnumerable<CinemaXNet.Domain.Entities.Movie> ?? new List<CinemaXNet.Domain.Entities.Movie>();
    var rooms = (ViewBag.Rooms as IEnumerable<CinemaXNet.Domain.Entities.Room> ?? new List<CinemaXNet.Domain.Entities.Room>()).ToList();
    
    // Lấy danh sách tỉnh thành từ dữ liệu Cinemas thay vì Rooms để đảm bảo Rạp mới tạo cũng có
    var cinemas = ViewBag.Cinemas as IEnumerable<CinemaXNet.Domain.Entities.Cinema> ?? new List<CinemaXNet.Domain.Entities.Cinema>();
    var provinces = cinemas
        .Select(c => c.Name + "|" + (c.Province ?? "Khác"))
        .Distinct()
        .ToList();

    var allProvinces = new[] {
        "TP. Hồ Chí Minh", "Hà Nội", "Đà Nẵng", "Cần Thơ", "Đồng Nai", "Hải Phòng", 
        "Quảng Ninh", "Bà Rịa-Vũng Tàu", "Bình Định", "Bình Dương", "Đắk Lắk", 
        "Trà Vinh", "Yên Bái", "Vĩnh Long", "Kiên Giang", "Hà Tĩnh", "Phú Yên", 
        "Đồng Tháp", "Bạc Liêu", "Hưng Yên", "Khánh Hòa", "Kon Tum", "Lạng Sơn", 
        "Nghệ An", "Phú Thọ", "Quảng Ngãi", "Sóc Trăng", "Sơn La", "Tây Ninh", 
        "Thái Nguyên", "Tiền Giang", "Gia Lai", "Ninh Thuận", "Bình Thuận"
    }.OrderBy(p => p).ToList();
}

<!-- Custom CSS for Deep Dark Theme and Showtimes -->
<style>
    .table-borderless-dark > :not(caption) > * > * {
        border-bottom-color: #27272a; /* border-secondary-subtle equivalent */
    }
    
    .showtime-card {
        background-color: #18181b;
        border: 1px solid #3f3f46;
        border-radius: 8px;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .showtime-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
        border-color: #3b82f6; /* Blue highlight */
    }
    
    .badge-format-2d { background-color: #3b82f6; color: white; }
    .badge-format-3d { background-color: #8b5cf6; color: white; }
    .badge-format-imax { background-color: #eab308; color: black; font-weight: bold; }
    .badge-province { background-color: #059669; color: white; font-size: 0.75rem; }
</style>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom border-secondary-subtle">
    <div>
        <h1 class="h2 text-body-emphasis fw-bold mb-0">Quản Lý Suất Chiếu</h1>
        <p class="text-secondary small mb-0">Theo dõi, sắp xếp lịch chiếu và định giá vé</p>
    </div>
    <button type="button" class="btn btn-primary fw-medium px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addShowtimeModal">
        <i class="bi bi-calendar-plus me-2"></i> Thêm suất chiếu mới
    </button>
</div>

<!-- Filters -->
<div class="card border border-secondary-subtle bg-transparent mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label text-body-emphasis small fw-medium">Chọn ngày</label>
                <input type="date" class="form-control bg-body text-body-emphasis border-secondary-subtle" name="date" value="@DateTime.Now.ToString("yyyy-MM-dd")">
            </div>
            <div class="col-md-3">
                <label class="form-label text-body-emphasis small fw-medium">Phim</label>
                <select class="form-select bg-body text-body-emphasis border-secondary-subtle">
                    <option value="">-- Tất cả phim --</option>
                    @foreach (var m in movies) {
                        <option value="@m.Id">@m.Title</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label text-body-emphasis small fw-medium">Tỉnh / Thành phố</label>
                <select class="form-select bg-body text-body-emphasis border-secondary-subtle">
                    <option value="">-- Toàn quốc (hiện tất cả) --</option>
                    @foreach (var p in allProvinces) {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-info w-100 fw-medium">Lọc danh sách</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-4 mb-5">
    @if (!showtimes.Any())
    {
        <div class="col-12">
            <div class="card border-0 bg-transparent text-center py-5">
                <div class="card-body">
                    <i class="bi bi-calendar-x fs-1 d-block mb-2 text-muted"></i>
                    <p class="text-secondary">Không có suất chiếu nào được tìm thấy.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        var groupedShowtimes = showtimes.OrderBy(s => s.StartTime).GroupBy(s => s.RoomId);
        
        foreach (var group in groupedShowtimes)
        {
            var room = rooms.FirstOrDefault(r => r.Id == group.Key);
            var cinemaName = room?.Cinema?.Name ?? "Không xác định";
            var provinceName = room?.Cinema?.Province ?? "Không xác định";
            <div class="col-12">
                <div class="card bg-body border border-secondary-subtle shadow-sm rounded-3">
                    <div class="card-header bg-body-tertiary border-bottom border-secondary-subtle py-3">
                        <h5 class="card-title text-body-emphasis fw-bold mb-0">
                            <i class="bi bi-door-open-fill me-2 text-warning"></i>@(room?.Name ?? "Không xác định")
                            <span class="fs-6 fw-normal text-secondary ms-2">— @cinemaName</span>
                            <span class="badge badge-province ms-2">@provinceName</span>
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var showtime in group)
                            {
                                var movie = movies.FirstOrDefault(m => m.Id == showtime.MovieId);
                                <div class="showtime-card p-3" style="min-width: 250px;">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="fw-bold text-body-emphasis fs-4 lh-1">@showtime.StartTime.ToString("HH:mm")</div>
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-link text-secondary p-0" type="button" data-bs-toggle="dropdown">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-dark shadow">
                                                <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#editShowtimeModal-@showtime.Id"><i class="bi bi-pencil me-2"></i>Sửa</a></li>
                                                <li><hr class="dropdown-divider border-secondary-subtle"></li>
                                                <li>
                                                    <form asp-controller="AdminShowtimes" asp-action="Delete" asp-route-id="@showtime.Id" method="post" onsubmit="return confirm('Xác nhận xóa suất chiếu này?');">
                                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Xóa</button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="text-body-emphasis fw-semibold text-truncate mb-1" title="@(movie?.Title)">
                                        @(movie?.Title ?? "Phim không xác định")
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        @if(showtime.Format.Contains("IMAX", StringComparison.OrdinalIgnoreCase)) {
                                            <span class="badge badge-format-imax">@showtime.Format</span>
                                        } else if(showtime.Format.Contains("3D", StringComparison.OrdinalIgnoreCase)) {
                                            <span class="badge badge-format-3d">@showtime.Format</span>
                                        } else {
                                            <span class="badge badge-format-2d">@showtime.Format</span>
                                        }
                                        <span class="text-secondary small">@showtime.Price.ToString("N0") ₫</span>
                                    </div>
                                </div>
                                
                                <!-- Edit Modal for Showtime -->
                                <div class="modal fade" id="editShowtimeModal-@showtime.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content bg-body border border-secondary-subtle shadow-lg">
                                            <div class="modal-header border-bottom border-secondary-subtle">
                                                <h5 class="modal-title text-body-emphasis fw-bold">Chỉnh sửa suất chiếu #@showtime.Id</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <form asp-controller="AdminShowtimes" asp-action="Update" asp-route-id="@showtime.Id" method="post">
                                                <div class="modal-body p-4">
                                                    <div class="row g-3">
                                                        <div class="col-12">
                                                            <label class="form-label text-body-emphasis fw-medium">Phim *</label>
                                                            <select name="movieId" class="form-select bg-body text-body-emphasis border-secondary-subtle" required>
                                                                @foreach (var m in movies) {
                                                                    <option value="@m.Id" selected="@(m.Id == showtime.MovieId ? "selected" : null)">@m.Title (@m.DurationMinutes phút)</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="form-label text-body-emphasis fw-medium">Tỉnh / Thành phố</label>
                                                            <select class="form-select bg-body text-body-emphasis border-secondary-subtle edit-province-select" data-target="editCinemaSelect-@showtime.Id">
                                                                <option value="">-- Toàn quốc (hiện tất cả) --</option>
                                                                @foreach (var p in allProvinces) {
                                                                    var editRoom = rooms.FirstOrDefault(r => r.Id == showtime.RoomId);
                                                                    var currentProv = editRoom?.Cinema?.Province ?? "";
                                                                    <option value="@p" selected="@(p == currentProv ? "selected" : null)">@p</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="form-label text-body-emphasis fw-medium">Rạp chiếu</label>
                                                            <select id="editCinemaSelect-@showtime.Id" class="form-select bg-body text-body-emphasis border-secondary-subtle edit-cinema-select" data-target="editRoomSelect-@showtime.Id">
                                                                <option value="">-- Chọn rạp --</option>
                                                                @foreach (var c in cinemas) {
                                                                    var editRoom = rooms.FirstOrDefault(r => r.Id == showtime.RoomId);
                                                                    <option value="@c.Id" data-province="@(c.Province ?? "")" selected="@(c.Id == editRoom?.CinemaId ? "selected" : null)">@c.Name</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="form-label text-body-emphasis fw-medium">Phòng chiếu *</label>
                                                            <select name="roomId" id="editRoomSelect-@showtime.Id" class="form-select bg-body text-body-emphasis border-secondary-subtle room-select" required>
                                                                <option value="">-- Chọn phòng --</option>
                                                                @foreach (var r in rooms) {
                                                                    <option value="@r.Id" data-cinema="@r.CinemaId" selected="@(r.Id == showtime.RoomId ? "selected" : null)">@r.Name</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label text-body-emphasis fw-medium">Ngày chiếu *</label>
                                                            <input type="date" name="showDate" value="@showtime.ShowDate.ToString("yyyy-MM-dd")" class="form-control bg-body text-body-emphasis border-secondary-subtle" required>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label text-body-emphasis fw-medium">Giờ chiếu *</label>
                                                            <input type="time" name="startTime" value="@showtime.StartTime.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)" class="form-control bg-body text-body-emphasis border-secondary-subtle" required>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label text-body-emphasis fw-medium">Định dạng *</label>
                                                            <select name="format" class="form-select bg-body text-body-emphasis border-secondary-subtle">
                                                                @{
                                                                    var editFormats = new[] { "2D Phụ đề", "2D Lồng tiếng", "3D Phụ đề", "3D Lồng tiếng", "IMAX 2D", "IMAX 3D", "4DX" };
                                                                }
                                                                @foreach (var f in editFormats) {
                                                                    <option value="@f" selected="@(showtime.Format == f ? "selected" : null)">@f</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label text-body-emphasis fw-medium">Giá vé (VNĐ) *</label>
                                                            <input type="number" name="price" value="@showtime.Price" class="form-control bg-body text-body-emphasis border-secondary-subtle" required min="0" step="1000">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-top border-secondary-subtle p-3">
                                                    <button type="button" class="btn btn-outline-secondary px-4 fw-medium" data-bs-dismiss="modal">Hủy</button>
                                                    <button type="submit" class="btn btn-primary px-4 fw-medium">Lưu thay đổi</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Pagination -->
@{
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
}
@if (totalPages > 1)
{
    <nav aria-label="Pagination">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<!-- Add Modal -->
<div class="modal fade" id="addShowtimeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-body border border-secondary-subtle shadow-lg">
            <div class="modal-header border-bottom border-secondary-subtle">
                <h5 class="modal-title text-body-emphasis fw-bold">Thêm suất chiếu mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="AdminShowtimes" asp-action="Store" method="post">
                <div class="modal-body p-4">
                    <div class="alert alert-warning border-0 mb-4 bg-warning bg-opacity-10 text-warning rounded-3">
                        <i class="bi bi-info-circle-fill me-2"></i> <strong>Lưu ý:</strong> Vui lòng đảm bảo khoảng cách tối thiểu 15 phút giữa các suất chiếu trong cùng một phòng để nhân viên dọn dẹp vệ sinh.
                    </div>
                    
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label text-body-emphasis fw-medium">Phim *</label>
                            <select name="movieId" class="form-select bg-body text-body-emphasis border-secondary-subtle" required>
                                <option value="">-- Chọn phim --</option>
                                @foreach (var m in movies) {
                                    <option value="@m.Id">@m.Title (@m.DurationMinutes phút)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-body-emphasis fw-medium"><i class="bi bi-geo-alt-fill text-success"></i> Tỉnh / Thành phố</label>
                            <select class="form-select bg-body text-body-emphasis border-secondary-subtle" id="addProvinceSelect" data-target="addCinemaSelect">
                                <option value="">-- Toàn quốc (hiện tất cả) --</option>
                                @foreach (var p in allProvinces) {
                                    <option value="@p">@p</option>
                                }
                            </select>
                            <div class="form-text text-secondary"><i class="bi bi-info-circle me-1"></i>Chọn tỉnh để lọc danh sách rạp chiếu bên dưới.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-body-emphasis fw-medium">Rạp chiếu</label>
                            <select id="addCinemaSelect" class="form-select bg-body text-body-emphasis border-secondary-subtle" data-target="addRoomSelect">
                                <option value="">-- Chọn rạp --</option>
                                @foreach (var c in cinemas) {
                                    <option value="@c.Id" data-province="@(c.Province ?? "")">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-body-emphasis fw-medium">Phòng chiếu *</label>
                            <select name="roomId" id="addRoomSelect" class="form-select bg-body text-body-emphasis border-secondary-subtle room-select" required>
                                <option value="">-- Chọn phòng --</option>
                                @foreach (var r in rooms) {
                                    <option value="@r.Id" data-cinema="@r.CinemaId">@r.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-body-emphasis fw-medium">Ngày chiếu *</label>
                            <input type="date" name="showDate" class="form-control bg-body text-body-emphasis border-secondary-subtle" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-body-emphasis fw-medium">Giờ chiếu *</label>
                            <input type="time" name="startTime" class="form-control bg-body text-body-emphasis border-secondary-subtle" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-body-emphasis fw-medium">Định dạng *</label>
                            <select name="format" class="form-select bg-body text-body-emphasis border-secondary-subtle">
                                <option value="2D Phụ đề">2D Phụ đề</option>
                                <option value="2D Lồng tiếng">2D Lồng tiếng</option>
                                <option value="3D Phụ đề">3D Phụ đề</option>
                                <option value="3D Lồng tiếng">3D Lồng tiếng</option>
                                <option value="IMAX 2D">IMAX 2D</option>
                                <option value="IMAX 3D">IMAX 3D</option>
                                <option value="4DX">4DX</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-body-emphasis fw-medium">Giá vé cơ bản (VNĐ) *</label>
                            <input type="number" name="price" class="form-control bg-body text-body-emphasis border-secondary-subtle" required min="0" step="1000" value="90000">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top border-secondary-subtle p-3">
                    <button type="button" class="btn btn-outline-secondary px-4 fw-medium" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4 fw-medium">Thêm suất chiếu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JavaScript: Lọc rạp và phòng chiếu theo tỉnh thành -->
<script>
    const originalCinemas = {};
    const originalRooms = {};

    function saveOriginalOptions() {
        document.querySelectorAll('select.edit-cinema-select, #addCinemaSelect').forEach(el => {
            if (!el) return;
            originalCinemas[el.id] = Array.from(el.querySelectorAll('option')).map(opt => ({
                value: opt.value, 
                text: opt.text, 
                prov: opt.getAttribute('data-province')
            }));
        });
        
        document.querySelectorAll('select.room-select').forEach(el => {
            if (!el) return;
            originalRooms[el.id] = Array.from(el.querySelectorAll('option')).map(opt => ({
                value: opt.value, 
                text: opt.text, 
                cinema: opt.getAttribute('data-cinema')
            }));
        });
    }

    function filterCinemasByProvince(provinceSelectEl, cinemaSelectEl) {
        if (!cinemaSelectEl || !originalCinemas[cinemaSelectEl.id]) return;
        
        const selectedProvince = provinceSelectEl.value;
        const allOptions = originalCinemas[cinemaSelectEl.id];
        let currentlySelected = cinemaSelectEl.value;
        
        cinemaSelectEl.innerHTML = '';
        
        let hasSelectedInNewList = false;
        let firstValidValue = null;

        allOptions.forEach(opt => {
            if (!opt.value) { // "-- Chọn rạp --"
                cinemaSelectEl.add(new Option(opt.text, opt.value));
            } else if (!selectedProvince || opt.prov === selectedProvince) {
                const newOpt = new Option(opt.text, opt.value);
                newOpt.setAttribute('data-province', opt.prov);
                if (opt.value === currentlySelected) {
                    newOpt.selected = true;
                    hasSelectedInNewList = true;
                }
                if (!firstValidValue && opt.value) firstValidValue = opt.value;
                cinemaSelectEl.add(newOpt);
            }
        });

        if (!hasSelectedInNewList && firstValidValue) {
            cinemaSelectEl.value = firstValidValue;
        } else if (!hasSelectedInNewList) {
            cinemaSelectEl.value = '';
        }

        cinemaSelectEl.dispatchEvent(new Event('change'));
    }

    function filterRoomsByCinema(cinemaSelectEl, roomSelectEl) {
        if (!roomSelectEl || !originalRooms[roomSelectEl.id]) return;

        const selectedCinema = cinemaSelectEl.value;
        const allOptions = originalRooms[roomSelectEl.id];
        let currentlySelected = roomSelectEl.value;
        
        roomSelectEl.innerHTML = '';
        
        let hasSelectedInNewList = false;
        let firstValidValue = null;

        allOptions.forEach(opt => {
            if (!opt.value) { 
                roomSelectEl.add(new Option(opt.text, opt.value));
            } else if (!selectedCinema || opt.cinema === selectedCinema) {
                const newOpt = new Option(opt.text, opt.value);
                newOpt.setAttribute('data-cinema', opt.cinema);
                if (opt.value === currentlySelected) {
                    newOpt.selected = true;
                    hasSelectedInNewList = true;
                }
                if (!firstValidValue && opt.value) firstValidValue = opt.value;
                roomSelectEl.add(newOpt);
            }
        });

        if (!hasSelectedInNewList && firstValidValue) {
            roomSelectEl.value = firstValidValue;
        } else if (!hasSelectedInNewList) {
            roomSelectEl.value = '';
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        saveOriginalOptions();

        // Bắt sự kiện cho modal Thêm mới
        const addProvSelect = document.getElementById('addProvinceSelect');
        const addCinemaSelect = document.getElementById('addCinemaSelect');
        const addRoomSelect = document.getElementById('addRoomSelect');
        
        if (addProvSelect) {
            addProvSelect.addEventListener('change', function() {
                filterCinemasByProvince(this, addCinemaSelect);
            });
            // Delay slightly to let standard DOM render correctly before filtering
            setTimeout(() => addProvSelect.dispatchEvent(new Event('change')), 50);
        }
        if (addCinemaSelect) {
            addCinemaSelect.addEventListener('change', function() {
                filterRoomsByCinema(this, addRoomSelect);
            });
        }

        // Bắt sự kiện cho modal Sửa
        document.querySelectorAll('.edit-province-select').forEach(select => {
            select.addEventListener('change', function() {
                const targetId = this.getAttribute('data-target');
                const cinemaSelect = document.getElementById(targetId);
                if (cinemaSelect) filterCinemasByProvince(this, cinemaSelect);
            });
            setTimeout(() => select.dispatchEvent(new Event('change')), 50);
        });
        
        document.querySelectorAll('.edit-cinema-select').forEach(select => {
            select.addEventListener('change', function() {
                const targetId = this.getAttribute('data-target');
                const roomSelect = document.getElementById(targetId);
                if (roomSelect) filterRoomsByCinema(this, roomSelect);
            });
        });
    });
</script>

