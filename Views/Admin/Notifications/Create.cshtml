@{
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0 text-gray-800">@ViewBag.PageTitle</h2>
    <a href="/admin/notifications" class="btn btn-secondary shadow-sm">
        <i class="fas fa-arrow-left fa-sm text-white-50 mr-2"></i> Quay lại
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-body">
        <form action="/admin/notifications/create" method="post">
            @Html.AntiForgeryToken()
            
            <div class="mb-3">
                <label class="form-label">Tiêu đề <span class="text-danger">*</span></label>
                <input type="text" class="form-control" name="title" required maxlength="300" placeholder="Nhập tiêu đề thông báo">
            </div>

            <div class="mb-3">
                <label class="form-label">Loại thông báo</label>
                <select class="form-select" name="type">
                    <option value="system">Hệ thống</option>
                    <option value="promo">Khuyến mãi</option>
                    <option value="ticket">Vé</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Đối tượng nhận <span class="text-danger">*</span></label>
                <select class="form-select" name="target" id="targetSelect" onchange="toggleEmailField()">
                    <option value="all">Tất cả người dùng</option>
                    <option value="specific">Người dùng cụ thể</option>
                </select>
            </div>

            <div class="mb-3" id="emailField" style="display:none;">
                <label class="form-label">Email người nhận <span class="text-danger">*</span></label>
                <input type="email" class="form-control" name="email" id="emailInput" placeholder="Nhập email người dùng">
            </div>

            <div class="mb-3">
                <label class="form-label">Nội dung <span class="text-danger">*</span></label>
                <textarea class="form-control" name="message" rows="5" required placeholder="Nhập nội dung thông báo..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-paper-plane mr-2"></i> Gửi thông báo
            </button>
        </form>
    </div>
</div>

<script>
    function toggleEmailField() {
        var target = document.getElementById("targetSelect").value;
        var emailField = document.getElementById("emailField");
        var emailInput = document.getElementById("emailInput");
        if (target === "specific") {
            emailField.style.display = "block";
            emailInput.required = true;
        } else {
            emailField.style.display = "none";
            emailInput.required = false;
        }
    }
</script>
