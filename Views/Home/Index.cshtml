@{
    ViewData["Title"] = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var nowShowing = ViewBag.NowShowing as IEnumerable<CinemaXNet.Domain.Entities.Movie> ?? new List<CinemaXNet.Domain.Entities.Movie>();
    var comingSoon = ViewBag.ComingSoon as IEnumerable<CinemaXNet.Domain.Entities.Movie> ?? new List<CinemaXNet.Domain.Entities.Movie>();
    var promotions = ViewBag.Promotions as List<CinemaXNet.Application.ViewModels.PromotionItemViewModel> ?? new List<CinemaXNet.Application.ViewModels.PromotionItemViewModel>();
    var news       = ViewBag.News       as List<CinemaXNet.Application.ViewModels.NewsItemViewModel>       ?? new List<CinemaXNet.Application.ViewModels.NewsItemViewModel>();
}

<!-- Welcome Promo Modal -->
<div class="modal fade" id="welcomePromoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 bg-transparent">
            <div class="modal-body p-0 position-relative">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" style="z-index: 10; filter: drop-shadow(0 0 4px rgba(0,0,0,0.5));" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="card border-0 rounded-4 overflow-hidden shadow-lg">
                    <img src="/images/movies/lat-mat-7.jpg" class="w-100" style="height: 250px; object-fit: cover;" alt="Promo">
                    <div class="card-body p-4 text-center bg-white">
                        <span class="badge bg-danger mb-2">HOT DEAL</span>
                        <h4 class="text-primary fw-bold mb-3">TẶNG NGAY 50K CHO THÀNH VIÊN MỚI</h4>
                        <p class="text-secondary mb-4">Đăng ký thành viên CinemaX hôm nay và nhận ngay Voucher 50K áp dụng cho vé 2D bất kỳ!</p>
                        <a href="/register" class="btn btn-primary btn-lg rounded-pill fw-bold w-100 shadow-sm mb-2">ĐĂNG KÝ NHẬN QUÀ</a>
                        <button type="button" class="btn btn-link text-secondary text-decoration-none" data-bs-dismiss="modal">Không, cảm ơn</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- #1 Hero Section (3 Cột) -->
<style>
.full-width-breakout {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding-left: 0;
    padding-right: 0;
}
</style>
<section class="mb-5 full-width-breakout" data-aos="fade-in" data-aos-duration="1500" style="margin-top: -1.5rem;">
    <div class="row g-0 align-items-stretch">
        
        <!-- CỘT 1: Main Banner Slider (7/12) -->
        <div class="col-12 col-lg-7 d-flex flex-column">
            <div id="heroCarousel" class="carousel slide overflow-hidden flex-grow-1 border-end border-dark" data-bs-ride="carousel" style="min-height: 400px;">
                @{
                    var bannersList = ViewBag.Banners as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
                    var activeBanners = bannersList.ToList();
                }
                
                @if (activeBanners.Any())
                {
                    <div class="carousel-indicators">
                        @for (int i = 0; i < activeBanners.Count; i++)
                        {
                            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
                        }
                    </div>
                    <div class="carousel-inner h-100 bg-dark">
                        @for (int i = 0; i < activeBanners.Count; i++)
                        {
                            var banner = activeBanners[i];
                            <div class="carousel-item h-100 @(i == 0 ? "active" : "")">
                                <div class="position-relative h-100">
                                    <img src="@(banner.image_url ?? "/images/placeholder-banner.jpg")" class="w-100 h-100" style="object-fit: cover;" alt="@banner.title">
                                    <div class="carousel-caption text-start bottom-0 pb-4 pb-md-5 ps-3 ps-md-4 w-100" style="background: linear-gradient(transparent, rgba(0,0,0,0.95)); left: 0; right: 0;">
                                        <h2 class="h3 fw-medium text-white text-shadow mb-1">@banner.title</h2>
                                        @if (!string.IsNullOrEmpty((string)banner.description))
                                        {
                                            <p class="fs-6 text-light d-none d-sm-block mb-2">@banner.description</p>
                                        }
                                        @if (!string.IsNullOrEmpty((string)banner.link_url))
                                        {
                                            <a href="@banner.link_url" class="btn btn-sm btn-primary fw-medium px-3 rounded-3">Khám Phá</a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" aria-label="Slide trước">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" aria-label="Slide tiếp theo">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    </button>
                }
            </div>
        </div>

        <!-- CỘT 2: Widget Box Office (3/12) -->
        <div class="col-12 col-md-6 col-lg-3 d-flex flex-column">
            <div class="card border-0 overflow-hidden h-100 d-flex flex-column bg-white rounded-0 border-end border-dark">
                <!-- Header -->
                <div class="text-warning text-center py-2" style="background-color: #22252A; font-family: 'Space Grotesk', serif; font-style: italic; letter-spacing: 2px;">
                    BOX OFFICE
                </div>
                <!-- Body -->
                <div class="card-body p-0 flex-grow-1 overflow-auto" style="max-height: 350px;">
                    <div id="boxOfficeList" class="list-group list-group-flush small">
                        <!-- Dữ liệu được nạp qua API /api/movies/box-office -->
                        <div class="text-center py-4 text-muted">
                            <div class="spinner-border spinner-border-sm" role="status"></div>
                            <span class="ms-2">Đang tải dữ liệu...</span>
                        </div>
                    </div>
                </div>
                <!-- Footer -->
                <a href="/movies" class="btn btn-danger rounded-0 py-3 fw-bold text-uppercase w-100" style="font-size: 14px;">Mua vé ngay</a>
            </div>
        </div>

        <!-- CỘT 3: Featured Poster Banner (2/12) -->
        <div class="col-12 col-md-6 col-lg-2 d-flex flex-column">
            @{ 
                var featuredMovie = nowShowing.FirstOrDefault(m => m.Title.Contains("Đất Rừng") || m.Title.Contains("Mai") || m.Title.Contains("Dune") || m.Title.Contains("Lật Mặt")) ?? nowShowing.FirstOrDefault(); 
            }
            @if(featuredMovie != null) 
            {
                <div class="card border-0 overflow-hidden position-relative group w-100 rounded-0">
                    <img src="@(string.IsNullOrEmpty(featuredMovie.PosterUrl) ? "/images/movies/default.jpg" : featuredMovie.PosterUrl)" class="w-100 h-100" style="object-fit: cover; min-height: 400px;" alt="Featured">
                    <div class="position-absolute bottom-0 w-100 p-3 text-center" style="background: linear-gradient(transparent, rgba(0,0,0,0.9));">
                        <a href="/movies/@featuredMovie.Id" class="btn btn-sm btn-outline-light rounded-pill w-100 fw-medium">Xem chi tiết</a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>




<!-- #8 Movie Tabs (Thịnh Hành, Đang Chiếu, Sắp Chiếu) -->
<div class="mb-5 pt-2" data-aos="fade-up">
    <!-- Tabs Menu -->
    <ul class="nav nav-pills justify-content-center mb-4 custom-nav-pills gap-2" id="movie-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4 fw-medium text-uppercase shadow-sm" id="trending-tab" data-bs-toggle="pill" data-bs-target="#trending-content" type="button" role="tab" aria-controls="trending-content" aria-selected="true">
                <i class="bi bi-graph-up-arrow me-2"></i>Thịnh Hành
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 fw-medium text-uppercase shadow-sm" id="now-showing-tab" data-bs-toggle="pill" data-bs-target="#now-showing-content" type="button" role="tab" aria-controls="now-showing-content" aria-selected="false">
                <i class="bi bi-camera-reels me-2"></i>Đang Chiếu
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 fw-medium text-uppercase shadow-sm" id="coming-soon-tab" data-bs-toggle="pill" data-bs-target="#coming-soon-content" type="button" role="tab" aria-controls="coming-soon-content" aria-selected="false">
                <i class="bi bi-calendar-week me-2"></i>Sắp Chiếu
            </button>
        </li>
    </ul>

    <style>
        .custom-nav-pills .nav-link {
            color: var(--color-text-secondary, #6B7280);
            background-color: #fff;
            border: 2px solid #e5e7eb;
            transition: all 0.25s ease;
            font-size: 0.85rem;
            letter-spacing: 0.04em;
        }
        .custom-nav-pills .nav-link:hover {
            color: var(--color-primary, #F84464);
            background-color: #fff5f7;
            border-color: var(--color-primary, #F84464);
        }
        .custom-nav-pills .nav-link.active {
            color: #fff;
            background-color: var(--color-primary, #F84464);
            border-color: var(--color-primary, #F84464);
            box-shadow: 0 4px 14px rgba(248, 68, 100, 0.35) !important;
        }
        .group:hover .group-hover-scale {
            transform: scale(1.05);
        }
        .group:hover .overlay-hover {
            opacity: 1 !important;
        }
        .transition-transform {
            transition: transform 0.3s ease;
        }
        .transition-opacity {
            transition: opacity 0.3s ease;
        }
        .opacity-0 {
            opacity: 0;
        }
        .movie-carousel-item {
            width: calc(60% - 1.5rem);
        }
        @@media (min-width: 768px) {
            .movie-carousel-item {
                width: calc((100% - 2 * 1.5rem) / 3);
            }
        }
        @@media (min-width: 1024px) {
            .movie-carousel-item {
                width: calc((100% - 4 * 1.5rem) / 5);
            }
        }
        .group-carousel:hover .group-carousel-hover-opacity-100 {
            opacity: 1 !important;
        }
    </style>

    <!-- Tabs Content -->
    <div class="tab-content" id="movie-tabsContent">
        
        <!-- Tab: Thịnh Hành -->
        <div class="tab-pane fade show active" id="trending-content" role="tabpanel" aria-labelledby="trending-tab">
            <div class="position-relative group-carousel">
                <button class="btn btn-light rounded-circle shadow position-absolute top-50 start-0 translate-middle z-3 opacity-0 group-carousel-hover-opacity-100 transition-opacity" style="width: 48px; height: 48px; margin-top: -30px;" onclick="scrollMovieCarousel(this, -1)">
                    <i class="bi bi-chevron-left fs-4 text-dark fw-bold" style="margin-left:-2px;"></i>
                </button>
                
                <div class="d-flex gap-4 overflow-x-auto custom-scrollbar snap-x pb-4 movie-carousel-container" style="scroll-behavior: smooth;">
                    @{ 
                        int trendingCount = 0; 
                        var validTrendingMovies = nowShowing.Where(m => m != null && !string.IsNullOrWhiteSpace(m.Title) && !string.IsNullOrWhiteSpace(m.PosterUrl)).ToList();
                    }
                    @foreach (var movie in validTrendingMovies) {
                        trendingCount++;
                        if (trendingCount > 5) break;
                        <div class="movie-carousel-item flex-shrink-0 snap-start">
                            <div class="movie-poster-item position-relative overflow-hidden rounded-3 group bg-light shadow-sm" style="aspect-ratio: 2/3; cursor: pointer;" onclick="location.href='/movies/@movie.Id'">
                                <img src="@(movie.PosterUrl ?? "/images/movies/lat-mat-7.jpg")" class="w-100 h-100 object-fit-cover transition-transform duration-300 group-hover-scale" alt="@movie.Title" loading="lazy" decoding="async">
                                
                                @if (!string.IsNullOrEmpty(movie.AgeRating)) {
                                    <span class="badge position-absolute top-0 end-0 m-2 bg-dark text-white shadow-sm border border-secondary" style="z-index: 5;">@movie.AgeRating</span>
                                }
                                
                                <div class="overlay-hover position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-center align-items-center opacity-0 transition-opacity duration-300" style="background-color: rgba(0,0,0,0.75); z-index: 10;">
                                    <button class="btn btn-danger rounded-pill fw-bold px-4 shadow text-uppercase" onclick="event.stopPropagation(); location.href='/movies/@movie.Id#showtimes-section'">Mua vé ngay</button>
                                </div>
                                
                                <div class="position-absolute top-0 start-0 m-2" style="z-index: 6;">
                                    <span class="badge bg-danger shadow-sm" style="font-family: 'Arial Black', sans-serif; letter-spacing: 1px; font-size: 0.7rem;">TOP @trendingCount</span>
                                </div>
                            </div>
                            
                            <div class="pt-3 text-start">
                                <h6 class="text-dark fw-bold text-truncate mb-1" title="@movie.Title">@movie.Title</h6>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small"><i class="bi bi-clock me-1"></i>@movie.GetFormattedDuration()</span>
                                    <span class="text-muted small"><i class="bi bi-star-fill text-warning me-1"></i>4.8</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                
                <button class="btn btn-light rounded-circle shadow position-absolute top-50 end-0 translate-middle z-3 opacity-0 group-carousel-hover-opacity-100 transition-opacity" style="width: 48px; height: 48px; margin-top: -30px;" onclick="scrollMovieCarousel(this, 1)">
                    <i class="bi bi-chevron-right fs-4 text-dark fw-bold" style="margin-left:2px;"></i>
                </button>
            </div>
        </div>

        <!-- Tab: Đang Chiếu -->
        <div class="tab-pane fade" id="now-showing-content" role="tabpanel" aria-labelledby="now-showing-tab">
            @if (!nowShowing.Any()) {
                <p class="text-secondary text-center fst-italic">Hiện tại không có phim nào đang chiếu.</p>
            } else {
                <div class="position-relative group-carousel">
                    <button class="btn btn-light rounded-circle shadow position-absolute top-50 start-0 translate-middle z-3 opacity-0 group-carousel-hover-opacity-100 transition-opacity" style="width: 48px; height: 48px; margin-top: -30px;" onclick="scrollMovieCarousel(this, -1)">
                        <i class="bi bi-chevron-left fs-4 text-dark fw-bold" style="margin-left:-2px;"></i>
                    </button>
                    
                    <div class="d-flex gap-4 overflow-x-auto custom-scrollbar snap-x pb-4 movie-carousel-container" style="scroll-behavior: smooth;">
                        @{ var validNowShowing = nowShowing.Where(m => m != null && !string.IsNullOrWhiteSpace(m.Title)).ToList(); }
                        @foreach (var movie in validNowShowing) {
                            <div class="movie-carousel-item flex-shrink-0 snap-start">
                                <div class="movie-poster-item position-relative overflow-hidden rounded-3 group bg-light shadow-sm" style="aspect-ratio: 2/3; cursor: pointer;" onclick="location.href='/movies/@movie.Id'">
                                    <img src="@(movie.PosterUrl ?? "/images/movies/lat-mat-7.jpg")" class="w-100 h-100 object-fit-cover transition-transform duration-300 group-hover-scale" alt="@movie.Title" loading="lazy" decoding="async">
                                    
                                    @if (!string.IsNullOrEmpty(movie.AgeRating)) {
                                        <span class="badge position-absolute top-0 end-0 m-2 bg-dark text-white shadow-sm border border-secondary" style="z-index: 5;">@movie.AgeRating</span>
                                    }
                                    
                                    <div class="overlay-hover position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-center align-items-center opacity-0 transition-opacity duration-300" style="background-color: rgba(0,0,0,0.75); z-index: 10;">
                                        <button class="btn btn-danger rounded-pill fw-bold px-4 shadow text-uppercase" onclick="event.stopPropagation(); location.href='/movies/@movie.Id#showtimes-section'">Mua vé ngay</button>
                                    </div>
                                </div>
                                
                                <div class="pt-3 text-start">
                                    <h6 class="text-dark fw-bold text-truncate mb-1" title="@movie.Title">@movie.Title</h6>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted small"><i class="bi bi-clock me-1"></i>@movie.GetFormattedDuration()</span>
                                        <span class="text-muted small"><i class="bi bi-star-fill text-warning me-1"></i>4.8</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <button class="btn btn-light rounded-circle shadow position-absolute top-50 end-0 translate-middle z-3 opacity-0 group-carousel-hover-opacity-100 transition-opacity" style="width: 48px; height: 48px; margin-top: -30px;" onclick="scrollMovieCarousel(this, 1)">
                        <i class="bi bi-chevron-right fs-4 text-dark fw-bold" style="margin-left:2px;"></i>
                    </button>
                </div>
            }
        </div>

        <!-- Tab: Sắp Chiếu -->
        <div class="tab-pane fade" id="coming-soon-content" role="tabpanel" aria-labelledby="coming-soon-tab">
            @if (!comingSoon.Any()) {
                <p class="text-secondary text-center fst-italic">Không có phim sắp chiếu trong danh sách.</p>
            } else {
                <div class="coming-soon-timeline mb-4">
                    <div class="d-flex overflow-x-auto gap-3 py-2 custom-scrollbar month-filter-list" style="scroll-behavior: smooth;">
                        <button class="btn btn-primary rounded-pill px-4 month-filter-btn active" data-filter="all">Tất cả</button>
                        <button class="btn btn-outline-primary rounded-pill px-4 month-filter-btn" data-filter="8">Tháng 8</button>
                        <button class="btn btn-outline-primary rounded-pill px-4 month-filter-btn" data-filter="9">Tháng 9</button>
                        <button class="btn btn-outline-primary rounded-pill px-4 month-filter-btn" data-filter="10">Tháng 10</button>
                        <button class="btn btn-outline-primary rounded-pill px-4 month-filter-btn" data-filter="11">Tháng 11</button>
                        <button class="btn btn-outline-primary rounded-pill px-4 month-filter-btn" data-filter="12">Tháng 12</button>
                    </div>
                </div>
                <div class="position-relative group-carousel">
                    <button class="btn btn-light rounded-circle shadow position-absolute top-50 start-0 translate-middle z-3 opacity-0 group-carousel-hover-opacity-100 transition-opacity" style="width: 48px; height: 48px; margin-top: -30px;" onclick="scrollMovieCarousel(this, -1)">
                        <i class="bi bi-chevron-left fs-4 text-dark fw-bold" style="margin-left:-2px;"></i>
                    </button>
                    
                    <div class="d-flex gap-4 overflow-x-auto custom-scrollbar snap-x pb-4 movie-carousel-container" id="coming-soon-grid" style="scroll-behavior: smooth;">
                        @{ var validComingSoon = comingSoon.Where(m => m != null && !string.IsNullOrWhiteSpace(m.Title)).ToList(); }
                        @foreach (var movie in validComingSoon) {
                            <div class="movie-carousel-item flex-shrink-0 snap-start coming-soon-item" data-month="@( (movie.Id % 5) + 8 )">
                                <div class="movie-poster-item position-relative overflow-hidden rounded-3 group bg-light shadow-sm" style="aspect-ratio: 2/3; cursor: pointer;" onclick="location.href='/movies/@movie.Id'">
                                    <img src="@(movie.PosterUrl ?? "/images/movies/lat-mat-7.jpg")" class="w-100 h-100 object-fit-cover transition-transform duration-300 group-hover-scale" alt="@movie.Title" loading="lazy" decoding="async">
                                    
                                    @if (!string.IsNullOrEmpty(movie.AgeRating)) {
                                        <span class="badge position-absolute top-0 end-0 m-2 bg-dark text-white shadow-sm border border-secondary" style="z-index: 5;">@movie.AgeRating</span>
                                    }
                                    
                                    <div class="overlay-hover position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-center align-items-center opacity-0 transition-opacity duration-300" style="background-color: rgba(0,0,0,0.75); z-index: 10;">
                                        <button class="btn btn-danger rounded-pill fw-bold px-4 shadow text-uppercase" onclick="event.stopPropagation(); location.href='/movies/@movie.Id'">Xem chi tiết</button>
                                    </div>
                                </div>
                                
                                <div class="pt-3 text-start">
                                    <h6 class="text-dark fw-bold text-truncate mb-1" title="@movie.Title">@movie.Title</h6>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted small"><i class="bi bi-clock me-1"></i>@movie.GetFormattedDuration()</span>
                                        <span class="badge bg-secondary text-white font-monospace" style="font-size: 0.65rem;">SẮP CHIẾU</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <button class="btn btn-light rounded-circle shadow position-absolute top-50 end-0 translate-middle z-3 opacity-0 group-carousel-hover-opacity-100 transition-opacity" style="width: 48px; height: 48px; margin-top: -30px;" onclick="scrollMovieCarousel(this, 1)">
                        <i class="bi bi-chevron-right fs-4 text-dark fw-bold" style="margin-left:2px;"></i>
                    </button>
                </div>
            }
        </div>

    </div>
</div>

<!-- #9 Bắp Nước & Quà Tặng (Concessions & Merch) - NEW SECTION -->
<div class="mb-5 pt-4" data-aos="fade-up">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h4 text-success border-start border-success border-4 ps-3 fw-medium mb-0">
            <span class="section-icon section-icon-success"><i class="bi bi-cup-hot"></i></span>QUÀ TẶNG & BẮP NƯỚC
        </h2>
    </div>
    <div class="row g-4">
        <div class="col-md-6" data-aos="fade-right">
            <div class="card bg-white border-0 overflow-hidden rounded-2 h-100 shadow-lg position-relative group-hover">
                <img src="/images/movies/lat-mat-7.jpg" class="w-100 h-100 transition-all" style="object-fit: cover;" alt="Combo Avatar">
                <div class="position-absolute bottom-0 start-0 w-100 p-4" style="background: linear-gradient(transparent, rgba(255,255,255,0.95));">
                    <h4 class="text-primary fw-medium mb-1">Avatar: The Way of Water Combo</h4>
                    <p class="text-dark mb-2">1 Ly nước tạo hình + 1 Bắp khổng lồ + Tặng kèm Postcard</p>
                    <strong class="text-danger fs-5">299.000₫</strong>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-4 h-100">
                <div class="col-12 h-50" data-aos="fade-down">
                    <div class="card bg-white border-0 overflow-hidden rounded-2 h-100 shadow position-relative group-hover">
                        <img src="/images/movies/dao-pho-piano.jpg" class="w-100 h-100 transition-all" style="object-fit: cover;" alt="Combo Couple">
                        <div class="position-absolute bottom-0 start-0 w-100 p-3" style="background: linear-gradient(transparent, rgba(255,255,255,0.9));">
                            <h5 class="text-dark fw-medium mb-0">Combo Couple (2 Nước + 1 Bắp)</h5>
                            <strong class="text-primary">109.000₫</strong>
                        </div>
                    </div>
                </div>
                <div class="col-12 h-50" data-aos="fade-up">
                    <div class="card bg-white border-0 overflow-hidden rounded-2 h-100 shadow position-relative group-hover">
                        <img src="/images/movies/mai.jpg" class="w-100 h-100 transition-all" style="object-fit: cover;" alt="Dune Merch">
                        <div class="position-absolute bottom-0 start-0 w-100 p-3" style="background: linear-gradient(transparent, rgba(255,255,255,0.9));">
